{
  "name": "diff-breakdown",
  "version": "0.2.0",
  "private": true,
  "description": "A GitHub Action that explains the shape and architectural reach of a pull request.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "scripts": {
    "build": "node tools/prepare-dist.cjs && ncc build src/action.cjs --out dist --minify",
    "check:syntax": "node tools/check-syntax.cjs",
    "test": "node --test",
    "check": "npm run check:syntax && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@vercel/ncc": "0.45.0",
    "ajv": "8.20.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szijpeter/diff-breakdown.git"
  },
  "bugs": {
    "url": "https://github.com/szijpeter/diff-breakdown/issues"
  },
  "homepage": "https://github.com/szijpeter/diff-breakdown#readme",
  "keywords": [
    "github-action",
    "pull-request",
    "code-review",
    "kotlin",
    "swift",
    "java",
    "visualization"
  ]
}
